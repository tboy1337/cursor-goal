      },
      {
        "command": "python3 -u \"${CURSOR_PLUGIN_ROOT}/skills/cursor-goal/scripts/stop_hook.py\"",
        "loop_limit": null,
        "timeout": 30,
        "matcher": "goal-evaluator",
