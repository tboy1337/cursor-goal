      },
      {
        "command": "cmd /c \"${CURSOR_PLUGIN_ROOT}/skills/cursor-goal/scripts/stop_hook.cmd\"",
        "loop_limit": null,
        "timeout": 30,
        "matcher": "goal-auditor",
