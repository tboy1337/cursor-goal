      {
        "command": "cmd /c \"${CURSOR_PLUGIN_ROOT}/skills/cursor-goal/scripts/stop_hook.cmd\"",
        "loop_limit": null,
        "timeout": 30,
        "_cursor_goal": "cursor_goal_stop_hook"
      },
      {
        "command": "python3 -u \"${CURSOR_PLUGIN_ROOT}/skills/cursor-goal/scripts/stop_hook.py\"",
        "loop_limit": null,
        "timeout": 30,
        "_cursor_goal": "cursor_goal_stop_hook"
